# Server Configuration
PORT=3000

# Storage Configuration
DATA_DIR=./data

# Admin Interface Configuration
ADMIN_PASSWORD=admin123

# Session secret for cookie signing (change in production)
SESSION_SECRET=change-me-in-production

# API key for feedback + analytics endpoints (optional - if not set, accepts all)
# Clients must send X-API-Key header matching this value
# API_KEY=your-secret-api-key

# Database (optional - defaults to SQLite at DATA_DIR/onemind.db)
# DATABASE_URL=postgres://user:password@localhost:5432/onemind
