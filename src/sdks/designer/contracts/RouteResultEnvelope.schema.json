    "TopBlocker": {
      "description": "[S0] One obstacle and how many of the net's A* candidate edges it rejected.\n\n``obstacleId`` is engine-internal (compiled-board ids for snapshot geometry, ``State``-minted\nids for copper this run committed): stable WITHIN one job, meaningless across jobs. Use it to\ntell \"one wall rejected everything\" from \"a thousand obstacles each rejected once\", not as a\ndurable handle on a board feature.",
      "properties": {
        "obstacleId": {
          "title": "Obstacleid",
          "type": "string"
        },
        "rejectedEdges": {
          "title": "Rejectededges",
          "type": "integer"
        }
      },
      "required": [
        "obstacleId",
        "rejectedEdges"
      ],
      "title": "TopBlocker",
      "type": "object"
    },
