    "NetProbeStats": {
      "description": "[W1] Search-box widening probe, present ONLY on offline bench runs with the probe enabled\n(``ROUTE_BOUNDS_PROBE``). Diagnostic: it never influenced the emitted route.\n\n``minLevel`` = smallest widening level at which a natively-exhausted leg found a path (1-based;\nthe board-outline domain is the last level), -1 if none did. ``legsBudgetBound`` legs ran out\nof PROBE budget at a wider box \u2014 the box is implicated, but recoverability is unresolved, so\nthey must never be counted as recoveries. ``legsProbed`` counts LEGS; ``levelSearches`` counts\nthe widening searches those legs cost.",
      "properties": {
        "legsProbed": {
          "default": 0,
          "title": "Legsprobed",
          "type": "integer"
        },
        "levelSearches": {
          "default": 0,
          "title": "Levelsearches",
          "type": "integer"
        },
        "legsRecovered": {
          "default": 0,
          "title": "Legsrecovered",
          "type": "integer"
        },
        "legsBudgetBound": {
          "default": 0,
          "title": "Legsbudgetbound",
          "type": "integer"
        },
        "minLevel": {
          "default": -1,
          "title": "Minlevel",
          "type": "integer"
        },
        "expansions": {
          "default": 0,
          "title": "Expansions",
          "type": "integer"
        }
      },
      "title": "NetProbeStats",
      "type": "object"
    },
    "NetRouteStats": {
      "description": "[M-ML] Per-net features (first attempt) + labels (emit-best) \u2014 first-class ML training\ndata riding the payload (not the envelope id). Integers only (no 2^53 JSON overflow:\nbbox is W/H, not area). The existing 2-proc determinism suite gates these because they ride\nthe envelope \u2014 do NOT move them out of it.",
      "properties": {
        "netId": {
          "title": "Netid",
          "type": "string"
        },
        "pinCount": {
          "title": "Pincount",
          "type": "integer"
        },
        "bboxWNm": {
          "title": "Bboxwnm",
          "type": "integer"
        },
        "bboxHNm": {
          "title": "Bboxhnm",
          "type": "integer"
        },
        "bboxOverlapCount": {
          "title": "Bboxoverlapcount",
          "type": "integer"
        },
        "congestionInBbox": {
          "title": "Congestioninbbox",
          "type": "integer"
        },
        "attemptOrder": {
          "title": "Attemptorder",
          "type": "integer"
        },
        "blockedEscapes": {
          "title": "Blockedescapes",
          "type": "integer"
        },
        "routed": {
          "title": "Routed",
          "type": "boolean"
        },
        "lengthA": {
          "title": "Lengtha",
          "type": "integer"
        },
        "lengthB": {
          "title": "Lengthb",
          "type": "integer"
        },
        "viaCount": {
          "title": "Viacount",
          "type": "integer"
        },
        "bendCount": {
          "title": "Bendcount",
          "type": "integer"
        },
        "ripCount": {
          "title": "Ripcount",
          "type": "integer"
        },
        "passFirstRouted": {
          "title": "Passfirstrouted",
          "type": "integer"
        },
        "expansionsSpent": {
          "default": 0,
          "title": "Expansionsspent",
          "type": "integer"
        },
        "failureReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failurereason"
        },
        "boundaryBlockedNodes": {
          "default": 0,
          "title": "Boundaryblockednodes",
          "type": "integer"
        },
        "rejectedFixed": {
          "default": 0,
          "title": "Rejectedfixed",
          "type": "integer"
        },
        "rejectedRouter": {
          "default": 0,
          "title": "Rejectedrouter",
          "type": "integer"
        },
        "firstContactExpansion": {
          "default": -1,
          "title": "Firstcontactexpansion",
          "type": "integer"
        },
        "topBlockers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TopBlocker"
          },
          "title": "Topblockers",
          "type": "array"
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetProbeStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
