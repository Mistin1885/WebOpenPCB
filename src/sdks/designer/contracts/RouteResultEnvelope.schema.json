        "netId",
        "pinCount",
        "bboxWNm",
        "bboxHNm",
        "bboxOverlapCount",
        "congestionInBbox",
        "attemptOrder",
        "blockedEscapes",
        "routed",
        "lengthA",
        "lengthB",
