{
  "$defs": {
    "AiSourceRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "refId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refid"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "AiSourceRef",
      "type": "object"
    },
    "DesignerPcbFlipPlacementCommand": {
      "properties": {
        "type": {
          "const": "pcb_flip_placement",
          "default": "pcb_flip_placement",
          "title": "Type",
          "type": "string"
        },
        "placementId": {
          "title": "Placementid",
          "type": "string"
        }
      },
      "required": [
        "placementId"
      ],
      "title": "DesignerPcbFlipPlacementCommand",
      "type": "object"
    },
    "DesignerPcbMovePlacementCommand": {
      "properties": {
        "type": {
          "const": "pcb_move_placement",
          "default": "pcb_move_placement",
          "title": "Type",
          "type": "string"
        },
        "placementId": {
          "title": "Placementid",
          "type": "string"
        },
        "positionMm": {
          "$ref": "#/$defs/PointMm"
        }
      },
      "required": [
        "placementId",
        "positionMm"
      ],
      "title": "DesignerPcbMovePlacementCommand",
      "type": "object"
    },
    "DesignerPcbRotatePlacementCommand": {
      "properties": {
        "type": {
          "const": "pcb_rotate_placement",
          "default": "pcb_rotate_placement",
          "title": "Type",
          "type": "string"
        },
        "placementId": {
          "title": "Placementid",
          "type": "string"
        },
        "rotationDeg": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotationdeg",
          "type": "integer"
        }
      },
      "required": [
        "placementId",
        "rotationDeg"
      ],
      "title": "DesignerPcbRotatePlacementCommand",
      "type": "object"
    },
    "Determinism": {
      "properties": {
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "snapshotHash": {
          "title": "Snapshothash",
          "type": "string"
        },
        "engineVersion": {
          "title": "Engineversion",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        }
      },
      "required": [
        "seed",
        "snapshotHash",
        "engineVersion"
      ],
      "title": "Determinism",
      "type": "object"
    },
    "PlaceMetrics": {
      "properties": {
        "ratsnestLengthBeforeMm": {
          "default": 0.0,
          "title": "Ratsnestlengthbeforemm",
          "type": "number"
        },
        "ratsnestLengthAfterMm": {
          "default": 0.0,
          "title": "Ratsnestlengthaftermm",
          "type": "number"
        },
        "ratsnestImprovementPct": {
          "default": 0.0,
          "title": "Ratsnestimprovementpct",
          "type": "number"
        },
        "hpwlBeforeMm": {
          "default": 0.0,
          "title": "Hpwlbeforemm",
          "type": "number"
        },
        "hpwlAfterMm": {
          "default": 0.0,
          "title": "Hpwlaftermm",
          "type": "number"
        },
        "crossingsBefore": {
          "default": 0,
          "title": "Crossingsbefore",
          "type": "integer"
        },
        "crossingsAfter": {
          "default": 0,
          "title": "Crossingsafter",
          "type": "integer"
        },
        "congestionBefore": {
          "default": 0.0,
          "title": "Congestionbefore",
          "type": "number"
        },
        "congestionAfter": {
          "default": 0.0,
          "title": "Congestionafter",
          "type": "number"
        },
        "overlapPairsAfter": {
          "default": 0,
          "title": "Overlappairsafter",
          "type": "integer"
        },
        "overlapAreaAfterMm2": {
          "default": 0.0,
          "title": "Overlapareaaftermm2",
          "type": "number"
        },
        "edgeViolations": {
          "default": 0,
          "title": "Edgeviolations",
          "type": "integer"
        },
        "diffPairSkewBeforeMm": {
          "default": 0.0,
          "title": "Diffpairskewbeforemm",
          "type": "number"
        },
        "diffPairSkewAfterMm": {
          "default": 0.0,
          "title": "Diffpairskewaftermm",
          "type": "number"
        }
      },
      "title": "PlaceMetrics",
      "type": "object"
    },
    "PlaceOperation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pcb_move_placement",
            "pcb_rotate_placement",
            "pcb_flip_placement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "riskLevel": {
          "enum": [
            "low",
            "medium",
            "high",
            "destructive"
          ],
          "title": "Risklevel",
          "type": "string"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "pcb_flip_placement": "#/$defs/DesignerPcbFlipPlacementCommand",
              "pcb_move_placement": "#/$defs/DesignerPcbMovePlacementCommand",
              "pcb_rotate_placement": "#/$defs/DesignerPcbRotatePlacementCommand"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DesignerPcbMovePlacementCommand"
            },
            {
              "$ref": "#/$defs/DesignerPcbRotatePlacementCommand"
            },
            {
              "$ref": "#/$defs/DesignerPcbFlipPlacementCommand"
            }
          ],
          "title": "Payload"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AiSourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "riskLevel",
        "payload"
      ],
      "title": "PlaceOperation",
      "type": "object"
    },
    "PlacePayloadSummary": {
      "properties": {
        "placedCount": {
          "title": "Placedcount",
          "type": "integer"
        },
        "totalComponents": {
          "title": "Totalcomponents",
          "type": "integer"
        },
        "locked": {
          "title": "Locked",
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/PlaceMetrics"
        },
        "determinism": {
          "$ref": "#/$defs/Determinism"
        },
        "restartStats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RestartStat"
          },
          "title": "Restartstats",
          "type": "array"
        },
        "unplaced": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnplacedComponent"
          },
          "title": "Unplaced",
          "type": "array"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "placedCount",
        "totalComponents",
        "locked",
        "metrics",
        "determinism"
      ],
      "title": "PlacePayloadSummary",
      "type": "object"
    },
    "PointMm": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "PointMm",
      "type": "object"
    },
    "RestartStat": {
      "description": "One SA restart's outcome (the winner flagged ``selected``).",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "seedKind": {
          "title": "Seedkind",
          "type": "string"
        },
        "hpwlMm": {
          "title": "Hpwlmm",
          "type": "number"
        },
        "ratsnestMm": {
          "title": "Ratsnestmm",
          "type": "number"
        },
        "overlapPairs": {
          "title": "Overlappairs",
          "type": "integer"
        },
        "crossings": {
          "title": "Crossings",
          "type": "integer"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "seedKind",
        "hpwlMm",
        "ratsnestMm",
        "overlapPairs",
        "crossings"
      ],
      "title": "RestartStat",
      "type": "object"
    },
    "UnplacedComponent": {
      "properties": {
        "placementId": {
          "title": "Placementid",
          "type": "string"
        },
        "reason": {
          "enum": [
            "no_legal_position",
            "locked",
            "oversized_for_board",
            "non_cardinal_rotation",
            "cancelled"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "placementId",
        "reason"
      ],
      "title": "UnplacedComponent",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "designer_pcb_autoplace",
      "default": "designer_pcb_autoplace",
      "title": "Kind",
      "type": "string"
    },
    "toolName": {
      "default": "cloud_auto_place",
      "title": "Toolname",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "riskLevel": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "destructive"
      ],
      "title": "Risklevel",
      "type": "string"
    },
    "designId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Designid"
    },
    "baseRevision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baserevision"
    },
    "operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlaceOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/PlacePayloadSummary"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AiSourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "payload"
  ],
  "title": "PlacementResultEnvelope",
  "type": "object"
}
